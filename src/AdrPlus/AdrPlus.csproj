<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Version>1.0.0</Version>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<AssemblyName>adrplus</AssemblyName>
		<Authors>Fernando Cerqueira</Authors>
		<Copyright>Copyright © 2025 Fernando Cerqueira</Copyright>
		<PackageProjectUrl>https://github.com/FRACerqueira/AdrPlus</PackageProjectUrl>
		<RepositoryUrl>https://github.com/FRACerqueira/AdrPlus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>adrplus</ToolCommandName>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>icon.png</PackageIcon>
		<PackageTags>adr;architecture;decision-records;dotnet-tool;cli</PackageTags>
		<PackageDescription>A cross-platform .NET CLI tool for managing Architecture Decision Records (ADRs) — versioning, status workflows, interactive wizard and multi-language support.</PackageDescription>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\adr-template*.adrplus" />
		<EmbeddedResource Include="Resources\*-template*.md" />
	</ItemGroup>

	<!-- Pack README and icon into the NuGet package -->
	<ItemGroup>
		<None Include="..\..\NugetREADME.md" Pack="true" PackagePath="\README.md" />
		<None Include="..\..\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
		<PackageReference Include="PromptPlus" Version="6.0.0-rc2" />
		<PackageReference Include="Serilog.Extensions.Logging.File" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AdrPlus.Abstractions\AdrPlus.Abstractions.csproj" />
		<!-- Build-order dependency only (ReferenceOutputAssembly=false): the AdrIndexer plugin ships as loose
		     files under plugins-builtin\, staged explicitly below, not as a normal referenced assembly of
		     adrplus.dll itself (it must not end up bundled with AdrPlus.Abstractions.dll a second time — see
		     the None items below and AdrIndexerPluginEndToEndTests for why that breaks plugin type identity). -->
		<ProjectReference Include="..\AdrPlus.Plugins.AdrIndexer\AdrPlus.Plugins.AdrIndexer.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- Bundle the AdrIndexer reference plugin with the adrplus package itself; `adrplus init` copies these
	     into every new repo's ./plugins/adr-indexer/ folder (see InitCommandHandler.InstallBuiltinPlugins). -->
	<ItemGroup>
		<None Include="..\AdrPlus.Plugins.AdrIndexer\bin\$(Configuration)\$(TargetFramework)\AdrPlus.Plugins.AdrIndexer.dll" Link="plugins-builtin\adr-indexer\AdrPlus.Plugins.AdrIndexer.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="..\AdrPlus.Plugins.AdrIndexer\plugin.json" Link="plugins-builtin\adr-indexer\plugin.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
		<None Include="..\AdrPlus.Plugins.AdrIndexer\indexadrs-template.md" Link="plugins-builtin\adr-indexer\indexadrs-template.md" CopyToOutputDirectory="PreserveNewest" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\AdrPlus.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AdrPlus.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\AdrPlus.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>AdrPlus.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="adrplus.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
