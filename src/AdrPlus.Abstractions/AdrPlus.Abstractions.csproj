<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<Version>1.0.0</Version>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<Authors>Fernando Cerqueira</Authors>
		<Copyright>Copyright © 2025 Fernando Cerqueira</Copyright>
		<PackageProjectUrl>https://github.com/FRACerqueira/AdrPlus</PackageProjectUrl>
		<RepositoryUrl>https://github.com/FRACerqueira/AdrPlus</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<IsPackable>false</IsPackable>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

</Project>
